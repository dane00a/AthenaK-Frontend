# Copy to .env and adjust as needed.

# Where the upstream AthenaK clone + per-project workspaces live.
# Use an absolute path; default shown.
ATHENAK_CACHE_DIR=~/.athenak-frontend
ATHENAK_GIT_URL=https://github.com/IAS-Astrophysics/athenak.git
ATHENAK_DEFAULT_REF=main

# Database (SQLite for local dev).
DATABASE_URL=sqlite:///./backend/athenak.db

# Celery + log pub/sub.
REDIS_URL=redis://localhost:6379/0

# FastAPI CORS (comma-separated origins).
CORS_ORIGINS=http://localhost:5173

# Build parallelism. Leave empty to default to nproc.
BUILD_JOBS=

# API base URL the frontend talks to.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
