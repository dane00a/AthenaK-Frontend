  auto &w0 = pmbp->pmhd->w0;
  {% endif %}

  par_for("user_problem_init", DevExeSpace(), 0, nmb - 1, ks, ke, js, je, is, ie,
  KOKKOS_LAMBDA(int m, int k, int j, int i) {
    // >>> user:init_body
    {% if initial_condition == "uniform" %}
    w0(m, IDN, k, j, i) = 1.0;
    w0(m, IVX, k, j, i) = 0.0;
    w0(m, IVY, k, j, i) = 0.0;
    w0(m, IVZ, k, j, i) = 0.0;
    w0(m, IEN, k, j, i) = 1.0;
    {% elif initial_condition == "shock_tube" %}
    Real x = CellCenterX(i - is, indcs.nx1, size.d_view(m).x1min, size.d_view(m).x1max);
    if (x < 0.0) {
      w0(m, IDN, k, j, i) = 1.0;
      w0(m, IEN, k, j, i) = 1.0;
    } else {
      w0(m, IDN, k, j, i) = 0.125;
      w0(m, IEN, k, j, i) = 0.1;
    }
    w0(m, IVX, k, j, i) = 0.0;
    w0(m, IVY, k, j, i) = 0.0;
    w0(m, IVZ, k, j, i) = 0.0;
    {% elif initial_condition == "blast" %}
    Real x = CellCenterX(i - is, indcs.nx1, size.d_view(m).x1min, size.d_view(m).x1max);
    Real y = CellCenterX(j - js, indcs.nx2, size.d_view(m).x2min, size.d_view(m).x2max);
    Real r2 = x * x + y * y;
    w0(m, IDN, k, j, i) = 1.0;
    w0(m, IVX, k, j, i) = 0.0;
    w0(m, IVY, k, j, i) = 0.0;
    w0(m, IVZ, k, j, i) = 0.0;
    w0(m, IEN, k, j, i) = (r2 < 0.01) ? 10.0 : 0.1;
    {% elif initial_condition == "gaussian" %}
    Real x = CellCenterX(i - is, indcs.nx1, size.d_view(m).x1min, size.d_view(m).x1max);
    w0(m, IDN, k, j, i) = 1.0 + 0.1 * std::exp(-x * x / 0.05);
    w0(m, IVX, k, j, i) = 0.0;
    w0(m, IVY, k, j, i) = 0.0;
    w0(m, IVZ, k, j, i) = 0.0;
    w0(m, IEN, k, j, i) = 1.0;
    {% else %}
    // custom: fill me in
